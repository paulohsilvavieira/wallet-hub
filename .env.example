# Credenciais RPC do node Bitcoin regtest (stack `bitcoin`, mesmo valor do
# RPC_USER/RPC_PASSWORD usado lá).
RPC_USER=admin
RPC_PASSWORD=admin

# Nome da wallet auto-minerada do node — precisa bater com WALLET_NAME do
# container bitcoin-node (stack `bitcoin`).
WALLET_NAME=bitcoin-wallet-regtest

# RPC do Anvil, acessado só pelo proxy HTTPS do `ethereum-local-explorer`
# (location /rpc do nginx) — nunca porta 8545 direto. Localmente, se o
# ethereum-local-explorer estiver rodando com `make up` (docker-compose.local.yml),
# é algo como http://host.docker.internal:9000/rpc.
ANVIL_RPC_URL=https://seu-dominio.exemplo.com/rpc
# Mesmo valor do RPC_TOKEN configurado no ethereum-local-explorer.
ANVIL_RPC_TOKEN=

# Domínio público do explorer ETH (Blockscout, atrás do mesmo proxy) — só
# usado no frontend pra montar o link "ver no explorer" (build-time).
VITE_ETH_EXPLORER_URL=https://seu-dominio.exemplo.com

# Domínio/porta do btc-rpc-explorer (stack `bitcoin`).
VITE_EXPLORER_URL=http://localhost:3002

# Cadastro de admin é fechado: sem essas duas vars, ninguém vira admin.
# Sincronizado a cada boot — mudou a senha aqui? Só reiniciar o container
# que a senha do admin já atualiza sozinha, sem mexer no banco.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=troque-essa-senha
